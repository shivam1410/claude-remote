<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves this device in a backup. The shared key lives in the
     Keystore and is non-exportable anyway, but cloud backup of app data would
     be one more place session summaries could land. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
