{
  "name": "remote-session-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end encrypted bridge publishing local Claude Code session state to a paired Android client.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "doctor": "node src/service/doctor.mjs",
    "login": "node src/service/auth.mjs --login",
    "start": "node src/service/index.mjs",
    "rules-check": "node src/service/rules-check.mjs",
    "pair": "node src/service/pair.mjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "bin": {
    "bridge": "src/cli.mjs"
  }
}